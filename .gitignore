# ------------------------------------------------------------------
# Monorepo .gitignore
# Patterns without a leading "/" match at any depth, so they cover
# every service under apps/ (and packages/, libs/ if added later).
# ------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build output (NestJS, Vite/React dashboard)
dist/
build/
out/
*.tsbuildinfo

# Monorepo tool caches (Turborepo, Nx)
.turbo/
.nx/cache/
.nx/workspace-data/

# Other tool caches
.cache/
.eslintcache
.oxlintcache
.prettiercache
.vite/
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Tests
coverage/
.nyc_output/
junit.xml
test-results/

# Environment variables and secrets
# Commit a .env.example per service; never commit real values.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx

# Docker / local infrastructure data
# (Postgres, Redis, Kafka volumes mounted to the repo during local dev)
docker-compose.override.yml
compose.override.yml
.docker-data/
data/postgres/
data/redis/
data/kafka/
*.rdb
*.aof

# Kubernetes / Helm
# Keep manifests committed; ignore locally rendered secrets and chart deps.
*.secret.yaml
*.secret.yml
kubeconfig
.kube/
charts/*/charts/
charts/*/Chart.lock

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Temp
.temp/
.tmp/
tmp/
*.tmp

# IDEs and editors
.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
